' Relationships
Shape <|-- CompositeShape
Shape <|-- Rectangle
Shape <|-- Ellipse
Shape <|-- Line
Shape <|-- Text
Shape <|-- Image

ShapeFactory <|-- RectangleFactory
ShapeFactory <|-- EllipseFactory
ShapeFactory <|-- LineFactory
ShapeFactory <|-- TextFactory
ShapeFactory <|-- ImageFactory
ShapeFactory --> Shape : "Creates"

' ============= MVC Components =============
class Model {
}

class CanvasView {
  +update()
}

class CanvasController {
  +createShape()
  +moveShape()
  +notify()
}

abstract class Observer {
  +update()
}

abstract class Subject{}

' MVC Relationships
Model --> Shape : "Holds"
CanvasView <.. Model
CanvasController <--> Model
CanvasController <--> CanvasView
CanvasController --> Command

Subject <|-- CanvasController : extends
Observer <|-- CanvasView : extends
Shape <|.. CanvasController : modifies

abstract class State {
  +handle()
}

class ContextState {
  +handle()
}

class PropertyState {
  +handle()
}

class SidebarState {
  +handle()
}

class UIContext {
  +updateState()
  +getState()
}

State <|-- ContextState
State <|-- PropertyState
State <|-- SidebarState
UIContext o- State : currentState

@enduml
